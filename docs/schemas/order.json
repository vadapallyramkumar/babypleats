{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babypleats.com/schemas/order.json",
  "title": "Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "source",
    "customer",
    "items",
    "totals",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "confirmed",
        "in_progress",
        "shipped",
        "delivered",
        "cancelled"
      ]
    },
    "source": {
      "type": "string",
      "enum": ["whatsapp", "website", "manual"]
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "phone"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "phone": { "type": "string", "minLength": 8 },
        "city": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "variantId", "productName", "qty", "unitPrice"],
        "properties": {
          "productId": { "type": "string", "minLength": 1 },
          "variantId": { "type": "string", "minLength": 1 },
          "productName": { "type": "string", "minLength": 1 },
          "sku": { "type": "string" },
          "size": { "type": "string" },
          "color": { "type": "string" },
          "qty": { "type": "integer", "minimum": 1 },
          "unitPrice": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtotal", "shipping", "total", "currency"],
      "properties": {
        "subtotal": { "type": "number", "minimum": 0 },
        "shipping": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "const": "INR" }
      }
    },
    "notes": { "type": "string" },
    "whatsappMessageId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
